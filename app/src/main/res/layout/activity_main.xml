<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="false">

    <com.rubcut.couchyappsmenu.ui.CouchyBackgroundView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- LEFT AREA (~33%): Completely transparent space, clicking/tapping closes menu -->
        <View
            android:id="@+id/dismiss_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="33"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="false" />

        <!-- RIGHT SIDE PANEL (~67%): Strongly darkened sliding drawer -->
        <com.rubcut.couchyappsmenu.ui.DrawerPanelView
            android:id="@+id/right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="67"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="26dp"
            android:paddingEnd="36dp"
            android:paddingBottom="16dp">

            <!-- Top Bar: Action Buttons & Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/section_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/apps_title"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Small Hidden Apps Button (icon-only, placed to the left of "Get more apps") -->
                <FrameLayout
                    android:id="@+id/btn_hidden_apps"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusDown="@+id/app_grid"
                    android:nextFocusLeft="@+id/btn_hidden_apps"
                    android:nextFocusRight="@+id/btn_get_apps">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/hidden_apps_title"
                        android:src="@drawable/ic_visibility_off" />
                </FrameLayout>

                <!-- Pill 1: Get more apps -->
                <LinearLayout
                    android:id="@+id/btn_get_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/app_grid"
                    android:nextFocusLeft="@+id/btn_hidden_apps"
                    android:nextFocusRight="@+id/btn_get_games"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_store" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/get_more_apps"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Pill 2: Get more games -->
                <LinearLayout
                    android:id="@+id/btn_get_games"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/app_grid"
                    android:nextFocusLeft="@+id/btn_get_apps"
                    android:nextFocusRight="@+id/btn_get_games"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_games" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/get_more_games"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4-Column Grid area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <GridView
                    android:id="@+id/app_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:horizontalSpacing="12dp"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="4"
                    android:overScrollMode="never"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/app_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/empty_title"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/empty_message"
                        android:textColor="#A0ABB5"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Loading State -->
                <LinearLayout
                    android:id="@+id/loading_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminateTint="#8AB4F8" />

                    <TextView
                        android:id="@+id/loading_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/loading_apps"
                        android:textColor="#A0ABB5"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </com.rubcut.couchyappsmenu.ui.DrawerPanelView>
    </LinearLayout>
</FrameLayout>
